# CazadorDescuentos - Ingestion & Extraction Configuration
# Configuración de ADB y Emulador Android
ADB_PATH=adb
ANDROID_SERIAL=

# Configuración del Extractor de Cupones (Historia 1)
OUTPUT_DIRECTORY=capturas
TIMEOUT_SECONDS=30
SCROLL_COUNT=3
SIMULATE_MODE=false
LOG_FILE=logs/ingestion.log

# Paquetes y actividades de Android por marca
# McDonald's
MCDONALDS_PACKAGE=com.mcdonalds.app
MCDONALDS_ACTIVITY=

# Burger King
BURGERKING_PACKAGE=ar.com.burgerking
BURGERKING_ACTIVITY=

# Mostaza
MOSTAZA_PACKAGE=com.mostaza.mostaza
MOSTAZA_ACTIVITY=
